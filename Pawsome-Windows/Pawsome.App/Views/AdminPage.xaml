<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pawsome.App.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="980" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="Admin" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Manage the shared Pawsome Firebase backend from Windows."
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Posts"/><TextBlock x:Name="PostCount" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Users"/><TextBlock x:Name="UserCount" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="Firebase"/><TextBlock Text="pawsome-90cb3" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>

            <InfoBar x:Name="MessageBar" IsOpen="False" />

            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="App settings" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="MaintenanceSwitch" Header="Maintenance mode" />
                    <ToggleSwitch x:Name="AdsSwitch" Header="Ads enabled" />
                    <TextBox x:Name="AnnouncementTitleBox" Header="Announcement title" />
                    <TextBox x:Name="AnnouncementBodyBox" Header="Announcement message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    <Button Content="Save settings" Click="SaveSettings_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Posts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Refresh" Click="Refresh_Click" />
                    </StackPanel>
                    <ListView x:Name="PostsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                        <TextBlock Text="{Binding Location}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Delete" Click="DeletePost_Click" Tag="{Binding Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
