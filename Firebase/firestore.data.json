{
  "version": 1,
  "collections": {
    "users": {
      "documentId": "<firebaseAuthUid>",
      "fields": {
        "Usename": {"type": "string", "required": false, "default": "User"},
        "ProfilePic": {"type": "string", "required": false, "default": ""},
        "UserID": {"type": "integer", "required": true, "default": 0},
        "LoginMethod": {"type": "string", "required": true, "allowedValues": ["Google", "Twitter", "Email/Password"]},
        "JoinedOn": {"type": "timestamp", "required": true, "value": "serverTimestamp"}
      }
    },
    "counter": {
      "documents": {
        "users": {
          "documentId": "users",
          "fields": {"lastUserNumber": {"type": "integer", "required": true, "default": 0}}
        }
      }
    },
    "posts": {
      "documentId": "<firestoreGeneratedId>",
      "fields": {
        "CatName": {"type": "string", "required": true},
        "description": {"type": "string", "required": false, "default": ""},
        "CatAge": {"type": "string", "required": false, "default": ""},
        "imageURL": {"type": "string", "required": true},
        "UserID": {"type": "integer", "required": true},
        "Username": {"type": "string", "required": true},
        "ProfilePic": {"type": "string", "required": false, "default": ""},
        "PostedAt": {"type": "timestamp", "required": true, "value": "serverTimestamp"},
        "likes": {"type": "array<string>", "required": true, "default": []},
        "commentCount": {"type": "integer", "required": true, "default": 0},
        "status": {"type": "string", "required": true, "allowedValues": ["LOST", "FOUND", "REUNITED"], "default": "LOST"},
        "location": {"type": "string", "required": false, "default": ""}
      },
      "subcollections": {
        "comments": {
          "documentId": "<firestoreGeneratedId>",
          "fields": {
            "text": {"type": "string", "required": true},
            "ownerUID": {"type": "string", "required": true},
            "ownerUsername": {"type": "string", "required": false, "default": "User"},
            "ownerProfilePic": {"type": "string", "required": false, "default": ""},
            "timestamp": {"type": "timestamp", "required": true, "value": "serverTimestamp"}
          }
        }
      }
    }
  }
}
