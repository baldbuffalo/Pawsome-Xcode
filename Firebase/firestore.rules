rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ── USERS ─────────────────────────────────────────────────────────────
    // Each user's profile is readable/writable only by that same signed-in user.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── USER NUMBER COUNTER ────────────────────────────────────────────────
    // Android uses counter/users.lastUserID when allocating sequential user numbers.
    match /counter/users {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['lastUserID'])
        && request.resource.data.lastUserID == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['lastUserID'])
        && request.resource.data.lastUserID == resource.data.lastUserID + 1;
      allow delete: if false;
    }

    // ── POSTS ──────────────────────────────────────────────────────────────
    // Signed-in users can view posts. Android currently stores the Firebase
    // UID in the ownerUID field when creating a post.
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUID == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.ownerUID == request.auth.uid
          && request.resource.data.ownerUID == resource.data.ownerUID
        )
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'commentCount'])
      );

      allow delete: if signedIn()
        && resource.data.ownerUID == request.auth.uid;

      // ── COMMENTS ─────────────────────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.ownerUID == request.auth.uid;

        allow update: if signedIn()
          && resource.data.ownerUID == request.auth.uid
          && request.resource.data.ownerUID == resource.data.ownerUID;

        allow delete: if signedIn()
          && resource.data.ownerUID == request.auth.uid;
      }
    }
  }
}
